# SendGrid API key for /api/lead notifications (the friend's own key in
# this deployment). When unset the route logs a warning and no-ops so the
# site keeps working in dev/preview.
SENDGRID_API_KEY=

# Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX).
# Get it at analytics.google.com → Admin → Data streams → Web → your
# stream → "Measurement ID". When unset, NO gtag script is rendered at
# all — the site ships zero Google JS. Config uses anonymize_ip and we
# never send form field values (PHI rule), only event names + form labels.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console ownership token (the content value of the
# <meta name="google-site-verification"> tag GSC's "HTML tag" method
# shows you). Renders the meta tag only when set.
NEXT_PUBLIC_GSC_VERIFICATION=

# Bing Webmaster Tools ownership token (the content value of the
# <meta name="msvalidate.01"> tag). Renders the meta tag only when set.
NEXT_PUBLIC_BING_VERIFICATION=
